<Application x:Class="UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style
            x:Key="PillButton"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="Foreground"
                Value="#727674" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Padding"
                Value="17,8" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="24"
                            Padding="{TemplateBinding Padding}">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Image
                                    x:Name="icon"
                                    Source="assets/package-bold-lightGray.png"
                                    Width="25"
                                    Height="25"
                                    Margin="0,0,10,0" />
                                <TextBlock
                                    x:Name="text"
                                    Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="DemiBold"
                                    Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="border"
                                    Property="Background"
                                    Value="#6C6EFB" />
                                <Setter
                                    TargetName="icon"
                                    Property="Source"
                                    Value="assets/package-bold-white.png" />
                                <Setter
                                    TargetName="text"
                                    Property="Foreground"
                                    Value="White" />
                            </Trigger>

                            <!-- Pressed -->
                            <Trigger
                                Property="IsPressed"
                                Value="True">
                                <Setter
                                    TargetName="border"
                                    Property="Background"
                                    Value="#4A4DE0" />
                                <Setter
                                    TargetName="text"
                                    Property="Foreground"
                                    Value="White" />
                            </Trigger>

                            <!-- Normal -->
                            <Trigger
                                Property="IsMouseOver"
                                Value="False">
                                <Setter
                                    TargetName="border"
                                    Property="Background"
                                    Value="Transparent" />
                                <Setter
                                    TargetName="text"
                                    Property="Foreground"
                                    Value="#727674" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

<Window
    x:Class="UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:UI"
    mc:Ignorable="d"
    Title="Mini-Ecomerce"
    Height="630"
    Width="1253">
    <Grid>
        <Border
            BorderBrush="#EBEBEB"
            BorderThickness="0,0,3,0"
            Background="White"
            Margin="0,0,932,0">
            <Grid
                Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <Image
                    Margin="60,50,0,0"
                    HorizontalAlignment="Left"
                    Source="/assets/Logo.png"
                    Width="100"
                    Height="40"
                    Stretch="Fill"
                    Grid.Row="1" />
                <Button
                    x:Name="ProductManagementButton"
                    Style="{StaticResource PillButton}"
                    local:ButtonHelper.IconSource="assets/package-bold-lightGray.png"
                    local:ButtonHelper.HoverIconSource="assets/package-bold-white.png"
                    Width="240"
                    Height="48"
                    Content="Product Management"
                    Margin="16,58,46,-106"
                    Grid.Row="2" />
                <Button
                    x:Name="CustomerManagementButton"
                    Style="{StaticResource PillButton}"
                    local:ButtonHelper.IconSource="assets/users-four-bold-lightGray.png"
                    local:ButtonHelper.HoverIconSource="assets/users-four-bold-white.png"
                    Width="240"
                    Height="48"
                    Content="Customer Management"
                    Margin="16,111,46,-159"
                    Grid.Row="2" />
                <Button
                    x:Name="OrderManagementButton"
                    Style="{StaticResource PillButton}"
                    local:ButtonHelper.IconSource="assets/notepad-bold-lightGray.png"
                    local:ButtonHelper.HoverIconSource="assets/notepad-bold-white.png"
                    Width="240"
                    Height="48"
                    Content="Order Management"
                    Margin="16,164,46,-212"
                    Grid.Row="2" />
                <Button
                    x:Name="ReportManagementButton"
                    Style="{StaticResource PillButton}"
                    local:ButtonHelper.IconSource="assets/chart-line-bold-lightGray.png"
                    local:ButtonHelper.HoverIconSource="assets/chart-line-bold-white.png"
                    Width="240"
                    Height="48"
                    Content="Report Management"
                    Margin="16,217,46,-265"
                    Grid.Row="2" />
            </Grid>
        </Border>
    </Grid>
</Window>

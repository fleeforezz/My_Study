<Window
    x:Class="UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:UI"
    mc:Ignorable="d"
    Title="MainWindow"
    Height="630"
    Width="1253">
    <Grid>
        <Border
            BorderBrush="#EBEBEB"
            BorderThickness="0,0,3,0"
            Background="White"
            Margin="0,0,932,0">
            <Grid
                Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="ProductManagementButton"
                    Style="{StaticResource PillButton}"
                    Width="243"
                    Height="48"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="23,122,0,0"
                    Click="ProductManagementButton_Click">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Width="210">
                        <Image
                            Source="assets/package-bold-lightGray.png"
                            Width="25"
                            Height="25"
                            Margin="0, 0, 10, 0"
                            RenderTransformOrigin="-0.15,0.552" />
                        <TextBlock
                            Text="Product Management"
                            FontSize="16"
                            FontWeight="DemiBold" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CustomerManagementButton"
                    Style="{StaticResource PillButton}"
                    Width="243"
                    Height="48"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="23,5,0,0"
                    Grid.Row="1">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Width="210">
                        <Image
                            Source="assets/package-bold-lightGray.png"
                            Width="25"
                            Height="25"
                            Margin="0, 0, 10, 0"
                            RenderTransformOrigin="-0.15,0.552" />
                        <TextBlock
                            Text="Customer Management"
                            FontSize="16"
                            FontWeight="DemiBold" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="OrderManagementButton"
                    Style="{StaticResource PillButton}"
                    Width="243"
                    Height="48"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="23,58,0,0"
                    Grid.Row="1">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Width="210">
                        <Image
                            Source="assets/package-bold-lightGray.png"
                            Width="25"
                            Height="25"
                            Margin="0, 0, 10, 0"
                            RenderTransformOrigin="-0.15,0.552" />
                        <TextBlock
                            Text="Order Management"
                            FontSize="16"
                            FontWeight="DemiBold" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ReportManagementButton"
                    Style="{StaticResource PillButton}"
                    Width="243"
                    Height="48"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="23,111,0,0"
                    Grid.Row="1">
                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Width="210">
                        <Image
                            Source="assets/package-bold-lightGray.png"
                            Width="25"
                            Height="25"
                            Margin="0, 0, 10, 0"
                            RenderTransformOrigin="-0.15,0.552" />
                        <TextBlock
                            Text="Report Management"
                            FontSize="16"
                            FontWeight="DemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
